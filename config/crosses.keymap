#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>

// ─── Layer indices ───────────────────────────────────────────────────────────
#define BASE   0
#define NAV    1
#define MOUSE  2
#define MEDIA  3
#define NUM    4
#define SYM    5
#define FUN    6

// ─── Timing constants ────────────────────────────────────────────────────────
// Adjust TAPPING_TERM up if you get accidental mods; down if mods feel sluggish
#define TAPPING_TERM   280
#define QUICK_TAP      175
// require-prior-idle: prevents mod trigger mid-roll (e.g. fast "as" won't fire Alt+S)
#define PRIOR_IDLE     150

/ {

    // ─── Behaviors ───────────────────────────────────────────────────────────

    behaviors {

        // Timeless home row mod — balanced flavor + require-prior-idle
        hm: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP>;
            require-prior-idle-ms = <PRIOR_IDLE>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        // Thumb layer-tap — shorter tapping term, no prior-idle needed on thumbs
        lt_thumb: layer_tap_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <QUICK_TAP>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        // Comma → semicolon on shift (mod-morph)
        cm_sc: comma_semicolon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Dot → colon on shift (mod-morph)
        dt_cl: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <2>;
            bindings = <&kp DOT>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Caps Word — auto-deactivates on space, punctuation, non-alpha
        caps_word {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <UNDERSCORE MINUS BSPC>;
        };
    };

    // ─── Combos ──────────────────────────────────────────────────────────────
    // All combos use adjacent keys so they never conflict with rolls

    combos {
        compatible = "zmk,combos";

        // Caps Word: both inner index keys simultaneously
        // (T + M on Colemak-DH, positions 8 + 21 in a 3x6 layout)
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <16 19>;  // left index home + right index home
            bindings = <&caps_word>;
        };

        // Escape: top two left-pinky keys (Q + A area)
        combo_esc {
            timeout-ms = <40>;
            key-positions = <0 10>;
            bindings = <&kp ESC>;
        };

        // Enter: right-hand middle+ring home row
        combo_ret {
            timeout-ms = <40>;
            key-positions = <21 22>;  // N + E on Colemak-DH right home
            bindings = <&kp RET>;
        };
    };

    // ─── Keymap ──────────────────────────────────────────────────────────────

    keymap {
        compatible = "zmk,keymap";

        // ╭─────────────────────────────────────────────────────────────────╮
        // │  BASE  –  Colemak-DH  +  GACS home row mods                    │
        // ├─────────────────────────────────────────────────────────────────┤
        // │  Q    W    F    P    B  │  J    L    U    Y    '               │
        // │  A    R    S    T    G  │  M    N    E    I    O               │
        // │  Z    X    C    D    V  │  K    H    ,;   .:   /               │
        // │       LGUI  Nav  Spc   │  Ret  Sym  Del                       │
        // │       Mouse Media      │       Num  Fun                        │
        // ╰─────────────────────────────────────────────────────────────────╯
        //
        // Home row mods (GACS — mirrored):
        //   Left:  A=GUI  R=Alt  S=Ctrl  T=Shift
        //   Right: N=Shift  E=Ctrl  I=Alt  O=GUI
        //
        // Thumb cluster:
        //   Left:  [LGUI] [hold=Nav  / tap=Space] [hold=Mouse / tap=Space(2)]
        //          The outer left thumb is a dedicated LGUI (common shortcut anchor)
        //   Right: [hold=Sym / tap=Ret] [hold=Num / tap=Bspc] [hold=Fun / tap=Del]
        //
        // The Media layer is accessed via: hold Nav + hold Mouse simultaneously (tri-layer)

        base_layer {
            label = "Base";
            bindings = 
                &kp Q        &kp W        &kp F        &kp P        &kp B
                &kp J        &kp L        &kp U        &kp Y        &kp SQT

                &hm LGUI A   &hm LALT R   &hm LCTRL S  &hm LSHFT T  &kp G
                &kp M        &hm RSHFT N  &hm RCTRL E  &hm RALT I   &hm RGUI O

                &kp Z        &kp X        &kp C        &kp D        &kp V
                &kp K        &kp H        &cm_sc       &dt_cl       &kp FSLH

                &kp LGUI  &lt_thumb NAV SPACE  &lt_thumb MOUSE TAB
                &lt_thumb SYM RET  &lt_thumb NUM BSPC  &lt_thumb FUN DEL
            >;
        };

        // ╭──────────────────────────────────────────────────────────────────╮
        // │  NAV  –  Right hand arrows + editing, left hand mods stay active │
        // ├──────────────────────────────────────────────────────────────────┤
        // │  ---  ---  ---  ---  ---  │  Redo  Paste  Copy  Cut  Undo      │
        // │  GUI  Alt  Ctrl Shft ---  │  ←     ↓      ↑     →    CapsLk   │
        // │  ---  ---  ---  ---  ---  │  Home  PgDn   PgUp  End  Ins      │
        // │        ___  ___  ___      │  Ret   Bspc   Del                  │
        // ╰──────────────────────────────────────────────────────────────────╯
        // One-handed nav: hold left thumb for layer, right hand navigates.
        // Mods on left home row stay active so you can Ctrl+arrow, Shift+arrow etc.

        nav_layer {
            label = "Nav";
            bindings = 
                &trans       &trans       &trans       &trans       &trans
                &kp K_REDO   &kp K_PASTE  &kp K_COPY   &kp K_CUT    &kp K_UNDO

                &kp LGUI     &kp LALT     &kp LCTRL    &kp LSHFT    &trans
                &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &kp CAPS

                &trans       &trans       &trans       &trans       &trans
                &kp HOME     &kp PG_DN    &kp PG_UP    &kp END      &kp INS

                &trans       &trans       &trans
                &kp RET      &kp BSPC     &kp DEL
            >;
        };

        // ╭──────────────────────────────────────────────────────────────────╮
        // │  MOUSE  –  Trackball gestures + scroll                          │
        // ╰──────────────────────────────────────────────────────────────────╯
        // Left hand: scroll (natural mapping — up/down/left/right)
        // Right hand: cursor movement (mirrors nav arrow positions)
        // Thumb: standard click trio

        mouse_layer {
            label = "Mouse";
            bindings = 
                &trans       &trans            &trans          &trans             &trans
                &trans       &trans            &trans          &trans             &trans

                &trans       &msc SCRL_LEFT    &msc SCRL_DOWN  &msc SCRL_UP       &msc SCRL_RIGHT
                &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT    &trans

                &trans       &trans            &trans          &trans             &trans
                &trans       &trans            &trans          &trans             &trans

                &trans       &trans       &trans
                &mkp RCLK    &mkp LCLK    &mkp MCLK
            >;
        };

        // ╭──────────────────────────────────────────────────────────────────╮
        // │  MEDIA  –  Tri-layer (Nav + Mouse held simultaneously)          │
        // │  Left: Bluetooth  /  Right: Media controls                      │
        // ╰──────────────────────────────────────────────────────────────────╯

        media_layer {
            label = "Media";
            bindings = 
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR
                &trans       &trans       &trans       &trans       &out OUT_TOG

                &trans       &trans       &trans       &trans       &trans
                &kp C_PREV   &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT   &trans

                &trans       &trans       &trans       &trans       &trans
                &trans       &trans       &trans       &trans       &trans

                &trans       &trans       &trans
                &kp C_STOP   &kp C_PP     &kp C_MUTE
            >;
        };

        // ╭──────────────────────────────────────────────────────────────────╮
        // │  NUM  –  Number pad on left, right mods active                  │
        // ├──────────────────────────────────────────────────────────────────┤
        // │  [    7    8    9    ]  │  ---  ---  ---  ---  ---             │
        // │  ;    4    5    6   =   │  ---  Shft Ctrl Alt  GUI            │
        // │  `    1    2    3   \   │  ---  ---  ---  ---  ---            │
        // │        .    0    -      │  ___  ___  ___                       │
        // ╰──────────────────────────────────────────────────────────────────╯
        // Number pad layout: matches numpad muscle memory (7-8-9 top, 1-2-3 bottom)
        // Right hand mods active so you can do Shift+number for symbols

        num_layer {
            label = "Num";
            bindings = 
                &kp LBKT     &kp N7       &kp N8       &kp N9       &kp RBKT
                &trans       &trans       &trans       &trans       &trans

                &kp SEMI     &kp N4       &kp N5       &kp N6       &kp EQUAL
                &trans       &kp RSHFT    &kp RCTRL    &kp RALT     &kp RGUI

                &kp GRAVE    &kp N1       &kp N2       &kp N3       &kp BSLH
                &trans       &trans       &trans       &trans       &trans

                &kp DOT      &kp N0       &kp MINUS
                &trans       &trans       &trans
            >;
        };

        // ╭──────────────────────────────────────────────────────────────────╮
        // │  SYM  –  Symbols on right hand (mirrors Num positions)          │
        // ├──────────────────────────────────────────────────────────────────┤
        // │  ---  ---  ---  ---  ---  │  {    &    *    (    }             │
        // │  GUI  Alt  Ctrl Shft ---  │  :    $    %    ^    +             │
        // │  ---  ---  ---  ---  ---  │  ~    !    @    #    |             │
        // │        ___  ___  ___      │  (    )    _                       │
        // ╰──────────────────────────────────────────────────────────────────╯
        // Symbols mirror the number pad position so muscle memory transfers:
        //   ! is where 1 is, @ where 2 is, etc.

        sym_layer {
            label = "Sym";
            bindings = 
                &trans       &trans       &trans       &trans       &trans
                &kp LBRC     &kp AMPS     &kp STAR     &kp LPAR     &kp RBRC

                &kp LGUI     &kp LALT     &kp LCTRL    &kp LSHFT    &trans
                &kp COLON    &kp DLLR     &kp PRCNT    &kp CARET    &kp PLUS

                &trans       &trans       &trans       &trans       &trans
                &kp TILDE    &kp EXCL     &kp AT       &kp HASH     &kp PIPE

                &kp LPAR     &kp RPAR     &kp UNDER
                &trans       &trans       &trans
            >;
        };

        // ╭──────────────────────────────────────────────────────────────────╮
        // │  FUN  –  F-keys on left (mirrors Num), system on right          │
        // ├──────────────────────────────────────────────────────────────────┤
        // │  F12  F7   F8   F9  PrtSc │  ---  ---  ---  ---  ---          │
        // │  F11  F4   F5   F6  ScrLk │  ---  Shft Ctrl Alt  GUI         │
        // │  F10  F1   F2   F3  Pause │  ---  ---  ---  Boot ---         │
        // │        App  Spc  Tab      │  ___  ___  ___                    │
        // ╰──────────────────────────────────────────────────────────────────╯

        fun_layer {
            label = "Fun";
            bindings = 
                &kp F12      &kp F7       &kp F8       &kp F9       &kp PSCRN
                &trans       &trans       &trans       &trans       &trans

                &kp F11      &kp F4       &kp F5       &kp F6       &kp SLCK
                &trans       &kp RSHFT    &kp RCTRL    &kp RALT     &kp RGUI

                &kp F10      &kp F1       &kp F2       &kp F3       &kp PAUSE_BREAK
                &trans       &trans       &trans       &bootloader  &trans

                &kp K_APP    &kp SPACE    &kp TAB
                &trans       &trans       &trans
            >;
        };
    };

    // ─── Tri-layer (Media) ───────────────────────────────────────────────────
    // Holding both Nav (layer 1) and Mouse (layer 2) activates Media (layer 3)

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV MOUSE>;
            then-layer = <MEDIA>;
        };
    };
};
